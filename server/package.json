{
  "name": "@tarefas/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "seed": "tsx src/db/seed.ts",
    "db:reset": "tsx src/db/seed.ts --reset",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx src/scripts/smoke.ts",
    "usuarios": "tsx src/scripts/users.ts",
    "backup": "tsx src/scripts/backup.ts",
    "build:vercel": "tsx src/scripts/build-vercel.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@tarefas/shared": "*",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2"
  }
}
