# Copie para server/.env para mudar algum valor. Nada aqui é obrigatório.

# Porta da API
PORT=3333

# Caminho do banco SQLite local (relativo à raiz do projeto)
DB_PATH=data/tarefas.db

# Banco no Turso (SQLite hospedado). Preenchidas, substituem o DB_PATH.
# Nunca coloque o token num arquivo que vai para o Git.
# TURSO_DATABASE_URL=libsql://nome-do-banco.turso.io
# TURSO_AUTH_TOKEN=

# Ligue quando o sistema estiver atrás de HTTPS
COOKIE_SECURE=false

# Senha dos usuários de exemplo criados pelo seed (só para desenvolvimento)
SEED_PASSWORD=tarefas@2026
